/*
 * IM168 Design Tokens v2.0
 * Single source of truth for the member app and operator surfaces.
 */
:root {
  color-scheme: light;

  /* Brand and semantic colors */
  --blue: #126BFF;
  --blue-d: #0B5ADC;
  --blue-dark: #0B5ADC;
  --tint: #E7F0FF;
  --blue-tint: #E7F0FF;
  --blue-soft: #EEF4FF;
  --ink: #414141;
  --muted: #9CA3AF;
  --line: #E8E8E8;
  --page: #F5F5F5;
  --surface: #FFFFFF;
  --win: #16A34A;
  --positive: #16A34A;
  --positive-soft: #E6F6EE;
  --red: #EF3939;
  --danger: #EF3939;
  --danger-soft: #FDECEC;
  --warning: #9A6C00;
  --warning-soft: #FFF8E0;
  --gold: #C08C38;

  /* Typography */
  --font: "Noto Sans SC", "PingFang SC", "Microsoft YaHei",
    -apple-system, "Segoe UI", Arial, sans-serif;
  --mono: var(--font);
  --fs-micro: 10px;
  --fs-caption: 12px;
  --fs-body: 14px;
  --fs-header: 17px;
  --fs-title: 18px;
  --fs-display: 28px;
  --lh-micro: 14px;
  --lh-caption: 18px;
  --lh-body: 20px;
  --lh-header: 24px;
  --lh-title: 26px;
  --lh-display: 34px;

  /* Spacing */
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 20px;
  --space-6: 24px;
  --space-8: 32px;

  /* Shape and sizing */
  --radius-sm: 8px;
  --radius-md: 10px;
  --radius-pill: 999px;
  --radius-sheet: 15px;
  --radius-device: 36px;
  --header-h: 54px;
  --control-h: 40px;
  --touch-min: 44px;
  --content-pad: 12px;

  /* Motion */
  --ease: cubic-bezier(.22, 1, .36, 1);
  --duration-fast: 140ms;
  --duration-base: 200ms;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
